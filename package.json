{
  "name": "jev-gateway-study",
  "private": true,
  "type": "module",
  "workspaces": [
    "gateway",
    "apps/doc-qa"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n gateway,doc-qa -c blue,green \"npm run dev -w gateway\" \"npm run dev -w doc-qa\"",
    "test": "npm test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "build": "npm run build -w doc-qa",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^5.9.3",
    "concurrently": "10.0.5"
  }
}
